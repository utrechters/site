{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Countries",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["code", "name"],
		"additionalProperties": false,
		"properties": {
			"code": {
				"type": "string",
				"pattern": "^[A-Z]{2}$",
				"description": "ISO 3166-1 alpha-2 country code"
			},
			"name": {
				"type": "string",
				"minLength": 1,
				"description": "English display name"
			}
		}
	}
}
