{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Items",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["id", "category", "intensity"],
		"additionalProperties": false,
		"properties": {
			"id": {
				"type": "string",
				"pattern": "^[a-z]{2}-[a-z0-9-]+$",
				"description": "Unique item id, prefixed with two-letter country code"
			},
			"category": {
				"type": "string",
				"enum": ["food", "place", "icon", "transport", "trait", "economics", "misc"],
				"description": "Thematic bucket for pairing items in a round"
			},
			"intensity": {
				"type": "integer",
				"minimum": 1,
				"maximum": 3,
				"description": "1 = light/fun, 2 = notable, 3 = identity-defining"
			}
		}
	}
}
